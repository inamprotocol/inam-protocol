{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inam-protocol-site",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/.well-known/agent-card.json", "/blog", "/use-cases/"]
  },
  "routes": [
    { "pattern": "inamprotocol.org", "custom_domain": true }
  ]
}
