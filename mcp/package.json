{
  "name": "inam-mcp",
  "version": "0.1.0",
  "description": "MCP server for the INAM Protocol — let an agent check a counterparty's reputation before trusting it, and emit a signed execution receipt when work is done",
  "type": "module",
  "bin": {
    "inam-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inam",
    "agent",
    "ai-agent",
    "reputation",
    "execution-receipt",
    "trust"
  ],
  "homepage": "https://inamprotocol.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inamprotocol/inam-protocol.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/inamprotocol/inam-protocol/issues",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "inamprotocol": "^0.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4"
  }
}
