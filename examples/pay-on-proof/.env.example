# Copy to .env in this folder (gitignored) and fill in what you have. Every rail without keys uses a stand-in.

# Braintree sandbox: Settings > API > API Keys (https://sandbox.braintreegateway.com)
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
# Optional: the sandbox merchant account's currency (see Settings > Business > Merchant Accounts)
BRAINTREE_CURRENCY=USD
# BRAINTREE_MERCHANT_ACCOUNT_ID=
# BRAINTREE_NONCE=fake-paypal-one-time-nonce

# PayPal sandbox: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# USDC over x402 on Base Sepolia (buyer wallet needs testnet USDC; never a mainnet key)
X402_BUYER_PRIVATE_KEY=
X402_SELLER_ADDRESS=

# AI (optional): either one
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
