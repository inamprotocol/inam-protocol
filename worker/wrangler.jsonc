{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inam-protocol",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "inam-protocol-db", "database_id": "475a0d9e-9212-4907-9223-08ac1ef04113" }
  ],
  "kv_namespaces": [
    { "binding": "IDEMPOTENCY", "id": "8ebaa8f6a6644b888a762a6a2ee60436" }
  ],
  "ratelimits": [
    { "name": "RATE_LIMIT_REGISTER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_WRITE", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_READ", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ]
}
