{
  "name": "inam-protocol-worker",
  "version": "0.6.7",
  "private": true,
  "description": "INAM Protocol Registry — Cloudflare Workers deployment (D1-backed)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init:local": "wrangler d1 execute inam-protocol-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute inam-protocol-db --remote --file=./schema.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
